# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov
.nyc_output

# Dependency directories
#
# This block is the guardrail for the plugin's core design property: it must
# ship NO dependencies, so that the host's pi-ai is the only pi-ai on the
# machine. If a node_modules/ were ever committed, a fresh `dsh plugin add`
# would install a vendored second copy of @earendil-works/pi-ai — exactly the
# pi-ai generation mismatch that breaks dsh-workbuddy-xdpool (see README).
node_modules/
jspm_packages/
web_modules/
.pnpm-store

# Build output
build/Release
dist
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# npm pack output
*.tgz

# Caches
.npm
.eslintcache
.stylelintcache
.node_repl_history
.cache
.parcel-cache
.turbo
.astro/
.vite/
.next
out
.nuxt
.output
.svelte-kit/

# Serverless / cloud emulators
.serverless/
.fusebox/
.dynamodb/
.firebase/

# TernJS
.tern-port

{
  "name": "dsh-zen-adapter",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OpenCode Zen free models as a native DeepSeek Harness LLM provider, with a live catalog discovered from the Zen gateway and models.dev.",
  "license": "MIT",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seonzzy/dsh-zen-adapter.git"
  },
  "homepage": "https://github.com/seonzzy/dsh-zen-adapter#readme",
  "bugs": {
    "url": "https://github.com/seonzzy/dsh-zen-adapter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-zen",
    "llm",
    "provider"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.82.0 <1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.1 <0.3.0-0"
  }
}
